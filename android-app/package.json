{
  "name": "pos-android",
  "private": true,
  "version": "1.0.0",
  "description": "Android app (Capacitor) wrapping the POS web app in ../web",
  "scripts": {
    "copy-web": "node -e \"const fs=require('fs');fs.rmSync('www',{recursive:true,force:true});fs.cpSync('../web','www',{recursive:true})\"",
    "sync": "npm run copy-web && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/core": "7.6.10"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10"
  }
}
