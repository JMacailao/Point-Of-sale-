# ---------------------------------------------------------------------------
# POS backend — copy to backend/.env and fill in. NEVER commit real values.
# These are server-side secrets: never put them in the frontend.
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
# Comma-separated list of allowed browser origins (your Vercel URL, local dev URL)
FRONTEND_URL=http://localhost:5173
# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY=1
LOG_LEVEL=info

# --- Firebase Admin SDK (Firebase console > Project settings > Service accounts > Generate new private key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private key with literal \n sequences, wrapped in double quotes
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Check token revocation on every request (immediate sign-out of deactivated users)
FIREBASE_CHECK_REVOKED=true
# Local development/testing ONLY (never in production): FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# --- Supabase PostgreSQL (Supabase dashboard > Connect > Session pooler or direct connection, user "postgres")
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
DATABASE_POOL_MAX=10

# --- Supabase Storage (Supabase dashboard > Project settings > API)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
